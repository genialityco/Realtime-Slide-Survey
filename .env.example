# Copia este archivo como .env en el servidor y completa los valores.

# Dominio público que apunta a la IP del Droplet (registro A en tu DNS).
# Sin dominio propio puedes usar la IP con guiones + sslip.io, p. ej.: 164-92-10-20.sslip.io
DOMAIN=encuestas.tudominio.com

# Contraseña del panel de administración (obligatoria: protege cédulas y correos).
ADMIN_PASSWORD=cambia-esta-clave
