rules_version = '2';

// Data model
//   admins/{uid}                                       who may manage everything (created by hand)
//   presentations/{pid}                                admin only
//   presentations/{pid}/slides/{slideId}               admin only
//   sessions/{sid}                                     public read (code, current slide); admin write
//   sessions/{sid}/polls/{slideId}                     poll instance: snapshot + published results; public read
//   sessions/{sid}/polls/{slideId}/votes/{cedula}      one vote per attendee and poll instance
//   sessions/{sid}/attendees/{cedula}                  registration (personal data): admin read only
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function session(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data;
    }

    function sessionLive(sid) {
      return session(sid).status == 'live';
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /presentations/{pid} {
      allow read, write: if isAdmin();

      match /slides/{slideId} {
        allow read, write: if isAdmin();
      }
    }

    match /sessions/{sid} {
      allow read: if true;
      allow write: if isAdmin();

      match /polls/{slideId} {
        allow read: if true;
        allow write: if isAdmin();

        match /votes/{cedula} {
          // An attendee votes once, as themselves, on the poll currently on screen, with a valid option.
          allow create: if signedIn()
            && get(/databases/$(database)/documents/sessions/$(sid)/attendees/$(cedula)).data.uid == request.auth.uid
            && sessionLive(sid)
            && session(sid).currentSlideId == slideId
            && request.resource.data.keys().hasOnly(['optionId', 'uid', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.optionId in
               get(/databases/$(database)/documents/sessions/$(sid)/polls/$(slideId)).data.optionIds;
          // The current holder of the registration may read its vote (or learn there is none yet),
          // also after taking the registration over from another phone; admins read everything.
          allow get: if isAdmin() || (signedIn() && (
            resource == null
            || resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/sessions/$(sid)/attendees/$(cedula)).data.uid == request.auth.uid));
          allow list: if isAdmin();
          allow update, delete: if false;
        }
      }

      match /attendees/{cedula} {
        function validAttendee(d) {
          return d.keys().hasOnly(['name', 'cedula', 'email', 'uid', 'consent', 'createdAt', 'updatedAt'])
            && d.name is string && d.name.size() >= 3 && d.name.size() <= 120
            && d.email is string && d.email.size() <= 160
            && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
            && d.cedula == cedula
            && d.uid == request.auth.uid
            && d.consent == true
            && d.updatedAt == request.time;
        }

        // Registering again with the same cédula (e.g. from another phone) takes over that registration,
        // keeping its votes; personal data is never readable by other attendees.
        allow create: if signedIn() && sessionLive(sid)
          && cedula.matches('^[0-9]{5,15}$')
          && validAttendee(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && sessionLive(sid)
          && validAttendee(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow get: if isAdmin() || (signedIn() && resource != null && resource.data.uid == request.auth.uid);
        allow list: if isAdmin();
        allow delete: if false;
      }
    }
  }
}
