{
  "name": "realtime-slide-survey",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "seed:simposio": "npm run seed:simposio -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
